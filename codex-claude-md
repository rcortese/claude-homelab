#!/usr/bin/env bash
set -euo pipefail

workspace="$(pwd)"
bootstrap=$(cat <<'EOF'
# Role: Homelab Administrator
You are the primary orchestrator for this infrastructure. Follow these non-negotiable rules:

## 1. Context Strategy
- At session start, read `./CLAUDE.md`.
- HIERARCHICAL LOADING: When entering a stack directory (e.g., network-stack/), find and read its local `CLAUDE.md`. Local rules override root rules.
- EXTENSIONS: Index `.claude/commands/` for slash commands (e.g., /backup, /stack-status). Use `read_file` on them for precise execution.

## 2. Safety Guardrails (Immediate Enforcement)
- ASK BEFORE: `docker compose down`, service restarts, deploys, or destructive git/file ops (rm -rf, git reset).
- VOLUMES: Never remove Docker volumes without explicit confirmation and a verified backup.
- ENV: After editing `.env` files, recreate services with `docker compose up -d`.

## 3. Communication Style
- Tables over prose. Minimalist output. No summaries unless asked.
- Pipe verbose command output through `| tail`. Use `--quiet` flags.
EOF
)

codex_args=()
user_prompt=""

while (($#)); do
  case "$1" in
    --)
      shift
      if (($#)); then
        user_prompt="$*"
      fi
      break
      ;;
    -*)
      codex_args+=("$1")
      shift
      if (($#)) && [[ ! "$1" =~ ^- ]]; then
        case "${codex_args[-1]}" in
          -c|--config|-m|--model|-p|--profile|-s|--sandbox|-a|--ask-for-approval|-C|--cd|--remote|--local-provider|--add-dir|-i|--image|--enable|--disable)
            codex_args+=("$1")
            shift
            ;;
        esac
      fi
      ;;
    *)
      user_prompt="$*"
      break
      ;;
  esac
done

if [[ -n "$user_prompt" ]]; then
  bootstrap+=$'\n\n'"User request: $user_prompt"
fi

exec codex -C "$workspace" "${codex_args[@]}" "$bootstrap"
